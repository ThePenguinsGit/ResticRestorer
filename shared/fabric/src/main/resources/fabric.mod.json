  "authors": [
    ""
  ],
  "contact": {
    "homepage": ""
  },
  "license": "All-Rights-Reserved",
  "icon": "assets/resticrestorer/icon.png",
  "environment": "*",
  "accessWidener": "resticrestorer.accesswidener",
  "entrypoints": {
